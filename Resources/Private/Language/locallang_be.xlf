            <trans-unit id="constants.settings.includeBootstrap">
                <source>Include Bootstrap from CDN:If this option is &#34;true&#34; then Bootstrap 5 will be included via CDN from jsDelivr. This option should only be used for testing purposes. If you want to use Bootstrap 5 (the default framework of the Partner Rating template) for rendering, it is recommended to include it yourself via your site package and leave this option disabled.</source>
            </trans-unit>
            <trans-unit id="constants.settings.cssFile">
                <source>Path to CSS file (FE):CSS file that is used by default</source>
            </trans-unit>
            <trans-unit id="constants.settings.javaScriptFile">
                <source>Path to JavaScript file (FE):JavaScript file that is used by default</source>
            </trans-unit>
            <trans-unit id="constants.settings.ratingValues">
                <source>Rating Values:Comma separated list of integer values that can be selected for the rating.</source>
            </trans-unit>
            <trans-unit id="constants.settings.ratingReasonMinValue">
                <source>Rating Reason Min. Value:If the selected rating exceeds this limit, then there is an obligation to select a reason.</source>
            </trans-unit>
            <trans-unit id="constants.settings.keepMinOneSearchResult">
                <source>Keep min. one search result:If this setting is `true`, then it is ensured that at least one result remains in the partner selection list, even if the entered string no longer leads to any results.</source>
            </trans-unit>
            <trans-unit id="constants.settings.partnerLabelFields">
                <source>Partner Label Fields:Comma-separated list of database fields to be used for forming the label of entries in the partner selection field. Fields that do not exist in the partner table are ignored.</source>
            </trans-unit>
            <trans-unit id="constants.settings.partnerLabelFieldSplitString">
                <source>Partner Label Field Split String:String used between label fields that are defined by `partnerLabelFields`.</source>
            </trans-unit>
            <trans-unit id="constants.settings.mail.subject">
                <source>Mail Subject</source>
            </trans-unit>
            <trans-unit id="constants.settings.description.mail.subject">
                <source>If no subject is specified, rating emails are disabled.</source>
            </trans-unit>
            <trans-unit id="constants.settings.mail.from">
                <source>Mail From</source>
